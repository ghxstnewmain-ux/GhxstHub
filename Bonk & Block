local function clearLightingEffects()
    for _, effect in pairs(lightingEffects) do
        pcall(function()
            if effect and effect.Parent then effect:Destroy() end
        end)
    end
    lightingEffects = {}
    for _, probe in pairs(lightingProbes) do
        pcall(function()
            if probe and probe.Parent then probe:Destroy() end
        end)
    end
    lightingProbes = {}
    if lightingTimeConn then
        pcall(function() lightingTimeConn:Disconnect() end)
        lightingTimeConn = nil
    end
end

local function setupSoftLighting()
    Lighting.Brightness = 1.6
    Lighting.GlobalShadows = true
    pcall(function() Lighting.ShadowSoftness = 0.6 end)
    Lighting.ClockTime = 17.2
    Lighting.GeographicLatitude = 35.5
    Lighting.ExposureCompensation = 0.8
    Lighting.Ambient = Color3.fromRGB(25, 22, 28)
