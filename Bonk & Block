-- ---------- RADAR (own small loop) ----------
local function startRadar()
    if radarConn then return end
    local Camera = Workspace.CurrentCamera
    local RadarInfo = { Position = Vector2.new(200, 200), Radius = 100, Scale = 1 }

    local function NewCircle(trans, col, radius, filled, thick)
        local c = Drawing.new("Circle")
        c.Transparency = trans
        c.Color = col
        c.Visible = true
        c.Thickness = thick or 1
        c.Position = RadarInfo.Position
        c.Radius = radius
        c.NumSides = math.clamp(radius * 55 / 100, 10, 75)
        c.Filled = filled
        return c
    end

    local bg = NewCircle(0.9, Colors.RadarBack, RadarInfo.Radius, true)
    local border = NewCircle(0.75, Colors.RadarBorder, RadarInfo.Radius, false, 3)
    local localDot = Drawing.new("Triangle")
    localDot.Visible = true
    localDot.Thickness = 1
    localDot.Filled = true
    localDot.Color = Colors.RadarLocal

    radarUI = { bg = bg, border = border, localDot = localDot, info = RadarInfo }

    local function ensureRadarDot(plr)
        if espState.radarDots[plr] then return espState.radarDots[plr] end
        local d = Drawing.new("Circle")
        d.Transparency = 1
        d.Color = Colors.RadarEnemy
        d.Visible = false
        d.Thickness = 1
        d.Radius = 3
        d.Filled = true
        d.NumSides = 12
        espState.radarDots[plr] = d
        return d
    end

    local function GetRelative(pos)
        local char = Players.LocalPlayer.Character
        if char and char.PrimaryPart then
            local pmpart = char.PrimaryPart
            local camerapos = Vector3.new(Camera.CFrame.Position.X, pmpart.Position.Y, Camera.CFrame.Position.Z)
            local newcf = CFrame.new(pmpart.Position, camerapos)
            local r = newcf:PointToObjectSpace(pos)
            return r.X, r.Z
        end
        return 0, 0
    end

    radarConn = RunService.RenderStepped:Connect(function()
        if not (Toggles.Radar and Toggles.Radar.Value) then return end
        local info = radarUI.info
        radarUI.bg.Color = Colors.RadarBack
        radarUI.border.Color = Colors.RadarBorder
        radarUI.localDot.Color = Colors.RadarLocal
        radarUI.localDot.PointA = info.Position + Vector2.new(0, -6)
        radarUI.localDot.PointB = info.Position + Vector2.new(-3, 6)
        radarUI.localDot.PointC = info.Position + Vector2.new(3, 6)
        radarUI.bg.Position = info.Position
        radarUI.bg.Radius = info.Radius
        radarUI.border.Position = info.Position
        radarUI.border.Radius = info.Radius

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == Players.LocalPlayer then
                -- skip
            elseif not shouldShowPlayer(plr) then
                local d = espState.radarDots[plr]
                if d then d.Visible = false end
            else
                local char, _, primary = getValidCharacter(plr)
                local d = ensureRadarDot(plr)
                if not char then
                    d.Visible = false
                else
                    local relx, rely = GetRelative(primary.Position)
                    local newpos = info.Position - Vector2.new(relx * info.Scale, rely * info.Scale)
                    if (newpos - info.Position).Magnitude < info.Radius - 2 then
                        d.Radius = 3
                        d.Position = newpos
                    else
                        local dist = (info.Position - newpos).Magnitude
                        local calc = (info.Position - newpos).Unit * (dist - info.Radius)
                        d.Position = Vector2.new(newpos.X + calc.X, newpos.Y + calc.Y)
                        d.Radius = 2
                    end
                    d.Visible = true
                    d.Color = (plr.TeamColor == Players.LocalPlayer.TeamColor) and Colors.RadarTeam or Colors.RadarEnemy
                end
            end
        end
    end)
end

local function stopRadar()
    if radarConn then radarConn:Disconnect(); radarConn = nil end
    if radarUI then
        pcall(function() radarUI.bg:Remove() end)
        pcall(function() radarUI.border:Remove() end)
        pcall(function() radarUI.localDot:Remove() end)
        radarUI = nil
    end
    for plr, d in pairs(espState.radarDots) do
        pcall(function() d:Remove() end)
        espState.radarDots[plr] = nil
    end
end

