    atmosphere.Offset = 0.2
    atmosphere.Color = Color3.fromRGB(255, 185, 115)
    atmosphere.Decay = Color3.fromRGB(240, 155, 90)
    atmosphere.Glare = 0.9
    atmosphere.Haze = 0.4
    atmosphere.Parent = Lighting
    return atmosphere
end

local function createGentleReflectionProbes()
    local probes = {}
    local shinyColors = {
        Color3.fromRGB(255, 200, 130),
        Color3.fromRGB(250, 195, 125),
        Color3.fromRGB(255, 205, 135),
        Color3.fromRGB(248, 192, 122),
    }
    for i = 1, 6 do
        local ok, probe = pcall(function()
            local p = Instance.new("ReflectionProbe")
            p.Size = Vector3.new(150, 150, 150)
            p.CFrame = CFrame.new(0, 35, 0) * CFrame.Angles(0, math.rad(i * 60), 0)
            p.Resolution = Enum.ReflectionProbeResolution.Resolution512
            p.FresnelStrength = 0.85
            p.Brightness = 1.3
            p.TintColor = shinyColors[(i % 4) + 1]
            p.Parent = Workspace
            return p
        end)
        if ok and probe then
            table.insert(probes, probe)
        end
    end
    return probes
end

local function createSoftBlur()
    local blur = Instance.new("BlurEffect")
    blur.Size = 1
    blur.Parent = Lighting
    return blur
end

local function enableVibrantRealistic()
    clearLightingEffects()
    setupSoftLighting()
    table.insert(lightingEffects, createSoftBloom())
    table.insert(lightingEffects, createSoftColorCorrection())
    table.insert(lightingEffects, createSoftSunRays())
    table.insert(lightingEffects, createSoftDepthOfField())
    table.insert(lightingEffects, setupSoftAtmosphere())
    table.insert(lightingEffects, createSoftBlur())
    lightingProbes = createGentleReflectionProbes()
    for _, probe in pairs(lightingProbes) do
        table.insert(lightingEffects, probe)
    end
    local timeDirection = 1
    lightingTimeConn = RunService.RenderStepped:Connect(function(deltaTime)
        if Lighting.ClockTime > 17.6 then
            timeDirection = -0.003
        elseif Lighting.ClockTime < 16.8 then
            timeDirection = 0.003
        end
        Lighting.ClockTime = Lighting.ClockTime + timeDirection * deltaTime
    end)
    lightingEnabled = true
end

local function applySkyPreset(preset)
    if not preset then return end
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if preset.Skybox then
        if not sky then
            sky = Instance.new("Sky")
            sky.Parent = Lighting
        end
        sky.SkyboxBk = preset.Skybox.Bk
        sky.SkyboxDn = preset.Skybox.Dn
        sky.SkyboxFt = preset.Skybox.Ft
        sky.SkyboxLf = preset.Skybox.Lf
        sky.SkyboxRt = preset.Skybox.Rt
        sky.SkyboxUp = preset.Skybox.Up
        pcall(function()
            sky.CelestialBodiesShown = true
            sky.StarCount = 4000
        end)
    else
        if sky then pcall(function() sky:Destroy() end) end
    end

    Lighting.ClockTime = preset.Time
    Lighting.ExposureCompensation = preset.Exposure
    Lighting.Ambient = preset.Ambient
    Lighting.OutdoorAmbient = preset.OutdoorAmbient
    Lighting.GlobalShadows = true

    local isDay = preset.Name:find("Daylight") ~= nil

    local bloom = Lighting:FindFirstChild("RoShade_Bloom") or Instance.new("BloomEffect")
    bloom.Name = "RoShade_Bloom"
    bloom.Intensity = isDay and 0.5 or 1.3
    bloom.Size = isDay and 15 or 26
    bloom.Threshold = 0.8
    bloom.Parent = Lighting

    local cc = Lighting:FindFirstChild("RoShade_CC") or Instance.new("ColorCorrectionEffect")
    cc.Name = "RoShade_CC"
    cc.Contrast = isDay and 0.12 or 0.22
    cc.Saturation = isDay and 0.15 or 0.25
    cc.TintColor = Color3.fromRGB(255, 255, 255)
    cc.Parent = Lighting

    local sunRays = Lighting:FindFirstChild("RoShade_SunRays") or Instance.new("SunRaysEffect")
    sunRays.Name = "RoShade_SunRays"
    sunRays.Intensity = isDay and 0.1 or 0.25
    sunRays.Spread = 0.75
    sunRays.Parent = Lighting

    local dof = Lighting:FindFirstChild("RoShade_DOF") or Instance.new("DepthOfFieldEffect")
    dof.Name = "RoShade_DOF"
    dof.FarIntensity = 0.15
    dof.FocusDistance = 35
    dof.InFocusRadius = 25
    dof.NearIntensity = 0
    dof.Parent = Lighting
end

local function cleanSSRLeftovers()
    for _, item in ipairs(Workspace:GetChildren()) do
        if item.Name == "RoShade_Base" or item.Name == "RoShade_Glass"
            or item.Name == "Physical_Mirror_Folder" or item.Name == "Global_SSR_Mirror_Plane" then
            pcall(function() item:Destroy() end)
        end
    end
    for _, part in ipairs(Workspace:GetDescendants()) do
        if part.Name == "SSR_Reflective_Layer" then
            pcall(function() part:Destroy() end)
        end
    end
end

local function clearSSRReflections()
    for part, clone in pairs(ssrWrappedParts) do
        pcall(function() if clone then clone:Destroy() end end)
    end
    for k in pairs(ssrWrappedParts) do
        ssrWrappedParts[k] = nil
    end
end

local function isCharacterPart(part)
    local parent = part.Parent
    while parent and parent ~= Workspace do
        if parent:IsA("Model") then
            if parent:FindFirstChildOfClass("Humanoid")
                or Players:GetPlayerFromCharacter(parent)
                or Players:FindFirstChild(parent.Name) then
                return true
            end
        end
        parent = parent.Parent
    end
    return false
end

local function wrapSSRPart(part)
    if not part:IsA("BasePart") then return end
    if part.Transparency >= 1 then return end
    if part.Name == "RoShade_Glass" or part.Name == "SSR_Reflective_Layer" then return end
    if part:FindFirstChild("SSR_Reflective_Layer") then return end
    if part.Name == "Terrain" then return end
    if isCharacterPart(part) then return end

    pcall(function()
        local oldArchivable = part.Archivable
        part.Archivable = true
        local clone = part:Clone()
        part.Archivable = oldArchivable
        for _, child in ipairs(clone:GetChildren()) do
            child:Destroy()
        end
        clone.Name = "SSR_Reflective_Layer"
        clone.Material = Enum.Material.Glass
        clone.Transparency = 4
        clone.CanCollide = false
        clone.CanTouch = false
        clone.CanQuery = false
        clone.CastShadow = false
        if clone:IsA("MeshPart") then
            clone.TextureID = ""
        end
        clone.Size = part.Size + Vector3.new(0.015, 0.015, 0.015)
        clone.CFrame = part.CFrame
        local hl = Instance.new("Highlight")
        hl.Name = "SSR_Highlight"
        hl.FillTransparency = 1
        hl.OutlineTransparency = 1
        hl.Parent = clone
        clone.Parent = part
        ssrWrappedParts[part] = clone
    end)
end

local function updateSSRFloorHeight()
    local character = Players.LocalPlayer.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = { character, Workspace:FindFirstChild("RoShade_Glass") }
    local result = Workspace:Raycast(root.Position, Vector3.new(0, -150, 0), raycastParams)
    if result then
        ssrMirrorY = result.Position.Y
        local distanceToGround = math.abs(root.Position.Y - ssrMirrorY)
        if ssrBasePart then
            if distanceToGround > 35 then
                ssrBasePart.Transparency = 1
            else
                ssrBasePart.Transparency = 5
            end
        end
    else
        if ssrBasePart then
            ssrBasePart.Transparency = 1
        end
    end
end

local function updateSSRFloor()
    if not ssrActive then return end
    if not ssrBasePart or not ssrBasePart.Parent then
        ssrBasePart = Instance.new("Part")
        ssrBasePart.Name = "RoShade_Glass"
        ssrBasePart.Size = Vector3.new(1000, 0.1, 1000)
        ssrBasePart.Material = Enum.Material.Glass
        ssrBasePart.Transparency = 5
        ssrBasePart.Anchored = true
        ssrBasePart.CanCollide = false
        ssrBasePart.CanTouch = false
        ssrBasePart.CanQuery = false
        ssrBasePart.CastShadow = false
        local hl = Instance.new("Highlight")
        hl.Name = "SSR_Highlight"
        hl.FillTransparency = 1
        hl.OutlineTransparency = 1
        hl.Parent = ssrBasePart
        ssrBasePart.Parent = Workspace
    end
end

local function stopSSR()
    ssrActive = false
    if ssrRenderConn then pcall(function() ssrRenderConn:Disconnect() end) ssrRenderConn = nil end
    if ssrWorkspaceConn then pcall(function() ssrWorkspaceConn:Disconnect() end) ssrWorkspaceConn = nil end
    -- scan loop checks ssrActive
    if ssrBasePart then pcall(function() ssrBasePart:Destroy() end) ssrBasePart = nil end
    pcall(function()
        if Workspace:FindFirstChild("RoShade_Glass") then Workspace.RoShade_Glass:Destroy() end
        if Workspace:FindFirstChild("RoShade_Base") then Workspace.RoShade_Base:Destroy() end
        if Workspace:FindFirstChild("Global_SSR_Mirror_Plane") then Workspace.Global_SSR_Mirror_Plane:Destroy() end
    end)
    clearSSRReflections()
end

local function startSSR()
    cleanSSRLeftovers()
    clearSSRReflections()
    ssrActive = true
    applySkyPreset(skyPresets[ssrCurrentPresetIndex])
    updateSSRFloorHeight()
    updateSSRFloor()

    if not ssrRenderConn then
        ssrRenderConn = RunService.RenderStepped:Connect(function()
            if not ssrActive then return end
            updateSSRFloorHeight()
            updateSSRFloor()
            local character = Players.LocalPlayer.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if root and ssrBasePart then
                ssrBasePart.Position = Vector3.new(root.Position.X, ssrMirrorY + 0.1, root.Position.Z)
            end
            pcall(function()
                local preset = skyPresets[ssrCurrentPresetIndex]
                if preset then
                    Lighting.ClockTime = preset.Time
                    Lighting.ExposureCompensation = preset.Exposure
                    Lighting.Ambient = preset.Ambient
                    Lighting.OutdoorAmbient = preset.OutdoorAmbient
                    Lighting.GlobalShadows = true
                end
            end)
        end)
    end

    if not ssrWorkspaceConn then
        ssrWorkspaceConn = Workspace.DescendantAdded:Connect(function(part)
            if not ssrActive then return end
            task.wait(0.5)
            pcall(function() wrapSSRPart(part) end)
        end)
    end

    task.spawn(function()
        while ssrActive do
            task.wait(1.5)
            if not ssrActive then break end
            local root = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root then
                for part, clone in pairs(ssrWrappedParts) do
                    if part and part.Parent then
                        local dist = (part.Position - root.Position).Magnitude
                        if dist > 60 then
                            pcall(function() clone:Destroy() end)
                            ssrWrappedParts[part] = nil
                        end
                    else
                        ssrWrappedParts[part] = nil
                    end
                end
                local count = 0
                for _, descendant in ipairs(Workspace:GetDescendants()) do
                    if not ssrActive then break end
                    if descendant:IsA("BasePart") then
                        local dist = (descendant.Position - root.Position).Magnitude
                        if dist <= 55 then
                            wrapSSRPart(descendant)
                        end
                    end
                    count = count + 1
                    if count % 150 == 0 then
                        task.wait()
                    end
                end
            end
        end
    end)
end

