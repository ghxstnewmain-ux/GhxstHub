local teamCheckEnabled = false

-- Drawing pools / state (created once, reused)
local espState = {
    health = {},      -- [player] = {bg, bar, outline}
    skeleton = {},    -- [player] = {lines = {...}}
    box = {},         -- [player] = {box}
    corner = {},      -- [player] = {lines = {TL1..BR2}, oripart}
    arrow = {},       -- [player] = {tri}
    view = {},        -- [player] = {line}
    charms = {},      -- [player] = {quads = {partName = {q1..q6}}}
    radarDots = {},   -- [player] = circle
}

local skeletonJointsR15 = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
}
local skeletonJointsR6 = {
    {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
    {"Torso", "Left Leg"}, {"Torso", "Right Leg"},
}

local function shouldShowPlayer(plr)
    if plr == Players.LocalPlayer then return false end
    if not teamCheckEnabled then return true end

    local char = plr.Character
    if not char then return false end

    local myChar = Players.LocalPlayer.Character
    local myTeam = (myChar and myChar:GetAttribute("MatchTeamId")) or Players.LocalPlayer:GetAttribute("MatchTeamId")
    local myGroup = (myChar and myChar:GetAttribute("MatchGroupId")) or Players.LocalPlayer:GetAttribute("MatchGroupId")
    local team = plr:GetAttribute("MatchTeamId") or char:GetAttribute("MatchTeamId")
    local group = plr:GetAttribute("MatchGroupId") or char:GetAttribute("MatchGroupId")

    if myTeam == nil or myGroup == nil or team == nil or group == nil then
        return true
    end
    return not (myGroup == group and myTeam == team)
end

local function getValidCharacter(plr)
    local char = plr.Character
    if not char or not char.Parent then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if not hum or not hrp then return nil end
    if hum.Health <= 0 and hum:GetState() == Enum.HumanoidStateType.Dead then
        return nil
    end
    return char, hum, hrp
end

local function getHealthColor(percent)
    if percent > 0.75 then return Color3.fromRGB(0, 255, 0)
    elseif percent > 0.5 then return Color3.fromRGB(255, 255, 0)
    elseif percent > 0.3 then return Color3.fromRGB(255, 165, 0)
    elseif percent > 0.15 then return Color3.fromRGB(255, 80, 0)
    else return Color3.fromRGB(255, 0, 0) end
end

local function getJoints(char)
    if char:FindFirstChild("UpperTorso") then return skeletonJointsR15 end
    if char:FindFirstChild("Torso") then return skeletonJointsR6 end
    return nil
end

-- ---------- ensure drawing objects exist for a player ----------
local function ensureHealth(player)
    if espState.health[player] then return espState.health[player] end
    local bg = Drawing.new("Square")
    bg.Filled = true
    bg.Color = Color3.fromRGB(0, 0, 0)
    bg.Thickness = 1
    bg.Transparency = 0.4
    bg.Visible = false
    local bar = Drawing.new("Square")
    bar.Filled = true
    bar.Thickness = 0
    bar.Visible = false
    local outline = Drawing.new("Square")
    outline.Filled = false
    outline.Color = Color3.fromRGB(0, 0, 0)
    outline.Thickness = 1
    outline.Visible = false
    local t = {bg = bg, bar = bar, outline = outline}
    espState.health[player] = t
    return t
end

local function ensureSkeleton(player)
    if espState.skeleton[player] then return espState.skeleton[player] end
    local lines = {}
    for i = 1, 14 do
        local line = Drawing.new("Line")
        line.Thickness = 1.5
        line.Color = Colors.Skeleton
        line.Visible = false
        lines[i] = line
    end
    local t = {lines = lines}
    espState.skeleton[player] = t
    return t
end

local function ensureBox(player)
