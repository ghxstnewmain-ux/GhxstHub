writefile("version.txt", "2.0.12i")

local function key(color)
    local colors = {
        RED = "\27[31m",
        GREEN = "\27[32m",
        YELLOW = "\27[33m",
        BLUE = "\27[34m",
        MAGENTA = "\27[35m",
        CYAN = "\27[36m",
        LIGHT_GRAY = "\27[37m",
    }
    rconsoleprint("[")
    rconsoleprint((colors[color] or "\27[37m") .. "KEY" .. "\27[0m")
    rconsoleprint("]")
end

local function info()
    rconsoleprint("[")
    rconsoleprint("\27[96mINFO\27[0m")
    rconsoleprint("]")
end

local function getversion()
    local ver = "2.0.12i"
    pcall(function()
        if isfile and isfile("version.txt") and readfile then
            ver = readfile("version.txt")
        end
    end)
    local t = {}
    for part in tostring(ver):gmatch("[^%.]+") do
        table.insert(t, part)
    end
    while #t < 3 do
        table.insert(t, "0")
    end
    return ("v%s.%s.%s"):format(t[1], t[2], t[3]):lower()
end

local KEY_FILE = "ghxsthub_key.txt"
local DAY = 86400

-- normalized (lowercase) keys
local KEY_DB = {
    -- 1-day (5)
    ["z1rb-m5jh-7obn-zr"] = { kind = "1d", seconds = 1 * DAY },
    ["cm+a-hxc2-#ccn-uz"] = { kind = "1d", seconds = 1 * DAY },
    ["atb5-pcay-nfpk-f3"] = { kind = "1d", seconds = 1 * DAY },
    ["embq-qdqf-jz0t-qw"] = { kind = "1d", seconds = 1 * DAY },
    ["ohrn-bwk#-m8ww-1s"] = { kind = "1d", seconds = 1 * DAY },
    -- 3-day (3)
    ["7_tr-l9xx-4vk8-rw"] = { kind = "3d", seconds = 3 * DAY },
    ["fzis-kspr-19sn-ji"] = { kind = "3d", seconds = 3 * DAY },
    ["1o5n-+oza-out?-qj"] = { kind = "3d", seconds = 3 * DAY },
    -- lifetime (2)
    ["knag-zcuu-iji5-#y"] = { kind = "lifetime", seconds = nil },
    ["t#em-c3yl-rcku-ow"] = { kind = "lifetime", seconds = nil },
}

local function normalizeKey(s)
    return tostring(s or ""):gsub("%s+", ""):lower()
end

local function readSave()
    if isfile and isfile(KEY_FILE) and readfile then
        local ok, data = pcall(readfile, KEY_FILE)
        if ok and data and data ~= "" then
            local k, exp = string.match(data, "^([^|]+)|(%-?%d+)")
            if k then
                return normalizeKey(k), tonumber(exp)
            end
            return normalizeKey(data), nil
        end
    end
    return nil, nil
end

local function writeSave(keyNorm, expiresAt)
    if writefile then
        pcall(writefile, KEY_FILE, tostring(keyNorm) .. "|" .. tostring(expiresAt or 0))
    end
end

local function clearSave()
    if isfile and isfile(KEY_FILE) and delfile then
        pcall(delfile, KEY_FILE)
    elseif writefile then
        pcall(writefile, KEY_FILE, "")
    end
end

local function validateKey(keyNorm, savedExpires)
    local info = KEY_DB[keyNorm]
    if not info then
        return false, nil
    end
    if info.seconds == nil then
        return true, 0 -- lifetime
    end
    local exp = savedExpires
    if not exp or exp == 0 then
        exp = os.time() + info.seconds
    end
    if os.time() > exp then
        return false, exp
    end
    return true, exp
end

local function checkingkey()
    key("GREEN")
    rconsoleprint(" Please enter your key: ")

    local input = normalizeKey(rconsoleinput())

    key("GREEN")
    rconsoleprint(" Checking key...\n")

    local ok, exp = validateKey(input, nil)
    if ok then
        writeSave(input, exp)
        wait(0.8)
        key("GREEN")
        local kind = KEY_DB[input] and KEY_DB[input].kind or "ok"
        rconsoleprint(" Correct key! (" .. tostring(kind) .. ")\n")
        wait(0.6)

        rconsoleprint("\n")
        info()
        rconsoleprint(" Loading Ghxst Hub...\n")
        wait(1.2)

        if rconsoledestroy then
            pcall(rconsoledestroy)
        end
        -- continue into hub below
    else
        wait(0.8)
        key("RED")
        rconsoleprint(" Incorrect key! Try again.\n")
        wait(1)
        checkingkey()
    end
end

local function inject()
    pcall(function()
        rconsolename("Ghxst Hub " .. getversion())
    end)
    pcall(rconsoleclear)
    info()
    rconsoleprint(" Initializing Ghxst Hub...\n")
    task.wait(0.7)

    local savedKey, savedExp = readSave()
    if savedKey then
        local ok, exp = validateKey(savedKey, savedExp)
        if ok then
            -- remember: skip prompt
            if exp and (not savedExp or savedExp == 0) and KEY_DB[savedKey] and KEY_DB[savedKey].seconds then
                writeSave(savedKey, exp)
            end
            info()
            rconsoleprint(" Saved key valid — loading...\n")
            task.wait(0.5)
            if rconsoledestroy then
                pcall(rconsoledestroy)
            end
            return
        else
            clearSave()
        end
    end

    checkingkey()
end

