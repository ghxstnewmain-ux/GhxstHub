local function hideAllForPlayer(player)
    local h = espState.health[player]
    if h then h.bg.Visible = false; h.bar.Visible = false; h.outline.Visible = false end
    local s = espState.skeleton[player]
    if s then for _, l in ipairs(s.lines) do l.Visible = false end end
    local b = espState.box[player]
    if b then b.box.Visible = false end
    local c = espState.corner[player]
    if c then for _, l in ipairs(c.lines) do l.Visible = false end end
    local a = espState.arrow[player]
    if a then a.tri.Visible = false end
    local v = espState.view[player]
    if v then v.line.Visible = false end
    local ch = espState.charms[player]
    if ch then
        for _, qs in pairs(ch.quads) do
            for _, q in ipairs(qs) do q.Visible = false end
        end
    end
    local rd = espState.radarDots[player]
    if rd then rd.Visible = false end
end

local function destroyPlayerESP(player)
    local function remDrawing(d)
        if d then pcall(function() d:Remove() end) end
    end
    local h = espState.health[player]
    if h then remDrawing(h.bg); remDrawing(h.bar); remDrawing(h.outline); espState.health[player] = nil end
    local s = espState.skeleton[player]
    if s then for _, l in ipairs(s.lines) do remDrawing(l) end; espState.skeleton[player] = nil end
    local b = espState.box[player]
    if b then remDrawing(b.box); espState.box[player] = nil end
    local c = espState.corner[player]
    if c then
        for _, l in ipairs(c.lines) do remDrawing(l) end
        if c.oripart then pcall(function() c.oripart:Destroy() end) end
        espState.corner[player] = nil
    end
    local a = espState.arrow[player]
    if a then remDrawing(a.tri); espState.arrow[player] = nil end
    local v = espState.view[player]
    if v then remDrawing(v.line); espState.view[player] = nil end
    local ch = espState.charms[player]
    if ch then
        for _, qs in pairs(ch.quads) do
            for _, q in ipairs(qs) do remDrawing(q) end
        end
        espState.charms[player] = nil
    end
    local rd = espState.radarDots[player]
    if rd then remDrawing(rd); espState.radarDots[player] = nil end
end

-- ---------- GUN ESP + SKIN CHANGER (shared connection) ----------
local gunEspCache = {}
local skinChangerEnabled = false
local selectedSkinName = nil
local currentSkinFolder = nil
local skinTextureCache = {} -- [skinName] = { textureIds = {}, colors = {}, surfaceApps = {} }

local function getSkinFolder()
    local assets = ReplicatedStorage and ReplicatedStorage:FindFirstChild("Assets")
    if not assets then return nil end
    return assets:FindFirstChild("Skin")
end

local function getSkinNames()
    local names = {}
    local folder = getSkinFolder()
    if not folder then return names end
    for _, child in ipairs(folder:GetChildren()) do
        table.insert(names, child.Name)
    end
    table.sort(names)
    return names
end

local function collectSkinData(skinName)
    if skinTextureCache[skinName] then
        return skinTextureCache[skinName]
    end
    local data = {
        textureIds = {},
        colors = {},
        materials = {},
        surfaceApps = {},
        defaultTexture = nil,
        defaultColor = nil,
    }
    local root = getSkinFolder()
    if not root then
        skinTextureCache[skinName] = data
        return data
    end
    local skin = root:FindFirstChild(skinName)
    if not skin then
        skinTextureCache[skinName] = data
        return data
    end

    for _, inst in ipairs(skin:GetDescendants()) do
        if inst:IsA("MeshPart") then
            if inst.TextureID and inst.TextureID ~= "" then
                table.insert(data.textureIds, inst.TextureID)
                if not data.defaultTexture then data.defaultTexture = inst.TextureID end
            end
            table.insert(data.colors, inst.Color)
            if not data.defaultColor then data.defaultColor = inst.Color end
            table.insert(data.materials, inst.Material)
        elseif inst:IsA("BasePart") and not inst:IsA("MeshPart") then
            table.insert(data.colors, inst.Color)
            if not data.defaultColor then data.defaultColor = inst.Color end
        elseif inst:IsA("Decal") or inst:IsA("Texture") then
            if inst.Texture and inst.Texture ~= "" then
                table.insert(data.textureIds, inst.Texture)
                if not data.defaultTexture then data.defaultTexture = inst.Texture end
            end
        elseif inst:IsA("SurfaceAppearance") then
            table.insert(data.surfaceApps, inst)
            if inst.ColorMap and inst.ColorMap ~= "" then
                table.insert(data.textureIds, inst.ColorMap)
                if not data.defaultTexture then data.defaultTexture = inst.ColorMap end
            end
        elseif inst:IsA("SpecialMesh") or inst:IsA("FileMesh") then
            if inst.TextureId and inst.TextureId ~= "" then
                table.insert(data.textureIds, inst.TextureId)
                if not data.defaultTexture then data.defaultTexture = inst.TextureId end
            end
        end
        -- attributes often store rbxassetid
        local attrTex = inst:GetAttribute("TextureID") or inst:GetAttribute("TextureId") or inst:GetAttribute("Texture")
        if typeof(attrTex) == "string" and attrTex ~= "" then
            table.insert(data.textureIds, attrTex)
            if not data.defaultTexture then data.defaultTexture = attrTex end
        end
    end

    -- also check direct children StringValues / ObjectValues
    for _, child in ipairs(skin:GetChildren()) do
        if child:IsA("StringValue") and child.Value ~= "" then
            if child.Name:lower():find("texture") or child.Value:find("rbxasset") then
                table.insert(data.textureIds, child.Value)
                if not data.defaultTexture then data.defaultTexture = child.Value end
            end
        elseif child:IsA("Color3Value") then
            if not data.defaultColor then data.defaultColor = child.Value end
            table.insert(data.colors, child.Value)
        end
    end

    skinTextureCache[skinName] = data
    return data
end

local function cleanGun(tool)
    for _, v in ipairs(tool:GetDescendants()) do
        if v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance")
        or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic")
        or v:IsA("ParticleEmitter") or v:IsA("Beam") or v:IsA("Trail") then
            pcall(function() v:Destroy() end)
        end
        if v:IsA("MeshPart") then
            pcall(function()
                v.TextureID = ""
                v.Material = Enum.Material.Neon
                v.MaterialVariant = ""
                v.Reflectance = 0
            end)
        end
        if v:IsA("SpecialMesh") or v:IsA("FileMesh") then
            pcall(function() v.TextureId = "" end)
        end
        if v:IsA("BasePart") then
            pcall(function()
                v.Material = Enum.Material.Neon
                v.MaterialVariant = ""
                v.Reflectance = 0
                v.CastShadow = false
            end)
        end
    end
end

local function applySkinToTool(tool, skinName)
    local root = getSkinFolder()
    if not root then return end
    local skin = root:FindFirstChild(skinName)
    if not skin then return end

    -- Build map of skin assets by lowercase name
    local byName = {}
    for _, inst in ipairs(skin:GetDescendants()) do
        byName[string.lower(inst.Name)] = inst
    end
    -- also top-level children
    for _, inst in ipairs(skin:GetChildren()) do
        byName[string.lower(inst.Name)] = inst
    end

    local data = collectSkinData(skinName)
    local fallbackTex = data.defaultTexture
    local fallbackCol = data.defaultColor

    for _, part in ipairs(tool:GetDescendants()) do
        if part:IsA("BasePart") then
            local key = string.lower(part.Name)
            local match = byName[key]

            -- strip old overlays so our texture shows
            for _, child in ipairs(part:GetChildren()) do
                if child:IsA("Decal") or child:IsA("Texture") or child:IsA("SurfaceAppearance") then
                    pcall(function() child:Destroy() end)
                end
            end

            local tex, col, mat

            if match then
                if match:IsA("MeshPart") then
                    if match.TextureID ~= "" then tex = match.TextureID end
                    col = match.Color
                    mat = match.Material
                elseif match:IsA("BasePart") then
                    col = match.Color
                    mat = match.Material
                elseif match:IsA("Decal") or match:IsA("Texture") then
                    tex = match.Texture
                elseif match:IsA("SurfaceAppearance") then
                    pcall(function()
                        local clone = match:Clone()
                        clone.Parent = part
                    end)
                    if match.ColorMap and match.ColorMap ~= "" then
                        tex = match.ColorMap
                    end
                elseif match:IsA("StringValue") and match.Value ~= "" then
                    tex = match.Value
                end

                -- nested texture under matched instance
                if not tex then
                    local nested = match:FindFirstChildWhichIsA("Decal", true)
                        or match:FindFirstChildWhichIsA("Texture", true)
                        or match:FindFirstChildWhichIsA("SurfaceAppearance", true)
                    if nested then
                        if nested:IsA("SurfaceAppearance") then
                            pcall(function()
                                local clone = nested:Clone()
                                clone.Parent = part
                            end)
                            tex = nested.ColorMap
                        else
                            tex = nested.Texture
                        end
                    end
                    if match:IsA("MeshPart") == false then
                        local mp = match:FindFirstChildWhichIsA("MeshPart", true)
                        if mp and mp.TextureID ~= "" then tex = mp.TextureID end
                    end
                end
            end

            tex = tex or fallbackTex
            col = col or fallbackCol
            mat = mat or data.materials[1] or Enum.Material.SmoothPlastic

            pcall(function()
                if part:IsA("MeshPart") then
                    if tex and tex ~= "" then
                        part.TextureID = tex
                    end
                end
                local sm = part:FindFirstChildOfClass("SpecialMesh") or part:FindFirstChildOfClass("FileMesh")
                if sm and tex and tex ~= "" then
                    sm.TextureId = tex
                end
                part.Material = mat
                part.MaterialVariant = ""
                part.Reflectance = 0
                if col then
                    part.Color = col
                end
            end)
        end
    end
end

local function applyRainbowToTool(tool)
    local color = Colors.Gun
    for _, part in ipairs(tool:GetDescendants()) do
        if part:IsA("Decal") or part:IsA("Texture") or part:IsA("SurfaceAppearance") then
            pcall(function() part:Destroy() end)
        elseif part:IsA("BasePart") then
            pcall(function()
                part.LocalTransparencyModifier = 0
                if part.Transparency >= 1 then part.Transparency = 0 end
                if part:IsA("MeshPart") then
                    part.TextureID = ""
                end
                local sm = part:FindFirstChildOfClass("SpecialMesh") or part:FindFirstChildOfClass("FileMesh")
                if sm then sm.TextureId = "" end
                part.Color = color
                part.Material = Enum.Material.Neon
                part.MaterialVariant = ""
                part.Reflectance = 0
                part.CastShadow = false
            end)
        end
    end
end

local function updatePlayerGuns(player)
    if not gunEspCache[player] then gunEspCache[player] = {tools = {}} end
    local char = player.Character
    if not char then return end
    local currentTools = {}

    -- IN-MATCH: weapons are Tools on the character
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            currentTools[child] = true
            gunEspCache[player].tools[child] = true
        end
    end

    -- LOBBY: Backweapon model on the character
    local backweapon = char:FindFirstChild("Backweapon")
    if backweapon then
        currentTools[backweapon] = true
        gunEspCache[player].tools[backweapon] = true
    end

    -- Any other weapon-like models
    for _, child in ipairs(char:GetChildren()) do
        local n = child.Name:lower()
        if child:IsA("Model") and child ~= backweapon and (n:find("weapon") or n:find("gun") or n:find("blaster")) then
            currentTools[child] = true
            gunEspCache[player].tools[child] = true
        end
    end

    -- Local backpack tools (unequipped but still skinnable)
    if player == Players.LocalPlayer then
        local backpack = player:FindFirstChild("Backpack")
        if backpack then
            for _, child in ipairs(backpack:GetChildren()) do
                if child:IsA("Tool") then
                    currentTools[child] = true
                    gunEspCache[player].tools[child] = true
                end
            end
        end
    end

    for tool in pairs(gunEspCache[player].tools) do
        if not currentTools[tool] then gunEspCache[player].tools[tool] = nil end
    end
end

local function applyToInstanceTree(root)
    if not root then return end
    if skinChangerEnabled and selectedSkinName then
        applySkinToTool(root, selectedSkinName)
    elseif Toggles.GunESP and Toggles.GunESP.Value then
        applyRainbowToTool(root)
    end
end

local function getViewModelsFolder()
    local assets = ReplicatedStorage and ReplicatedStorage:FindFirstChild("Assets")
    if not assets then return nil end
    local vfx = assets:FindFirstChild("VFX")
    if not vfx then return nil end
    return vfx:FindFirstChild("ViewModels")
end

-- True if model looks like this game's FP viewmodel (Body/Body2/BOLH etc.)
local function isViewModelModel(model)
    if not model or not model:IsA("Model") then return false end
    local hasBody = model:FindFirstChild("Body") or model:FindFirstChild("body")
    local hasBody2 = model:FindFirstChild("Body2") or model:FindFirstChild("body2")
    local hasBolh = model:FindFirstChild("BOLH") or model:FindFirstChild("RootPart")
    return hasBody ~= nil and (hasBody2 ~= nil or hasBolh ~= nil)
end

local function updateViewModel()
    local char = Players.LocalPlayer.Character

    -- 1) Equipped Tool (3rd person + shared meshes)
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") then
                applyToInstanceTree(child)
            end
        end
        local bw = char:FindFirstChild("Backweapon")
        if bw then applyToInstanceTree(bw) end
    end

    local backpack = Players.LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") then
                applyToInstanceTree(child)
            end
        end
    end

    -- 2) ReplicatedStorage templates: Assets.VFX.ViewModels.<GunName>
    local vmFolder = getViewModelsFolder()
    if vmFolder then
        local equippedName = nil
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then equippedName = tool.Name end
        end

        for _, vm in ipairs(vmFolder:GetChildren()) do
            if vm:IsA("Model") then
                -- Always skin the equipped gun's template; optionally all if you want
                if not equippedName or vm.Name == equippedName or vm.Name:find(equippedName, 1, true) then
                    applyToInstanceTree(vm)
                end
            end
        end

        -- If equipped tool name matches a viewmodel exactly
        if equippedName then
            local exact = vmFolder:FindFirstChild(equippedName)
            if exact then applyToInstanceTree(exact) end
        end
    end

    -- 3) Live clones anywhere (camera, workspace, character)
    local function scan(parent, depth)
        if not parent or depth > 4 then return end
        for _, child in ipairs(parent:GetChildren()) do
            if isViewModelModel(child) then
                applyToInstanceTree(child)
            elseif child:IsA("Model") or child:IsA("Folder") then
                scan(child, depth + 1)
            end
        end
    end

    local camera = Workspace.CurrentCamera
    if camera then scan(camera, 0) end
    if char then scan(char, 0) end
    -- shallow workspace scan for client-cloned viewmodels
    for _, child in ipairs(Workspace:GetChildren()) do
        if isViewModelModel(child) then
            applyToInstanceTree(child)
        end
    end
end

local gunConn = nil
local _gunFrame = 0

local function startGunLoop()
    if gunConn then return end
    gunConn = RunService.RenderStepped:Connect(function()
        local gunOn = Toggles.GunESP and Toggles.GunESP.Value
        local skinOn = skinChangerEnabled and selectedSkinName ~= nil
        if not gunOn and not skinOn then return end

        _gunFrame = _gunFrame + 1
        -- Always update local player every frame; throttle others
        local throttleOthers = (not skinOn) and (_gunFrame % 3) ~= 0

        for _, plr in ipairs(Players:GetPlayers()) do
            local isLocal = plr == Players.LocalPlayer
            if throttleOthers and not isLocal then
                -- skip other players this frame
            else
                local process = isLocal or skinOn or (gunOn and shouldShowPlayer(plr))
                if process then
                    updatePlayerGuns(plr)
                    local data = gunEspCache[plr]
                    if data then
                        for tool in pairs(data.tools) do
                            if tool and tool.Parent then
                                if skinOn then
                                    applySkinToTool(tool, selectedSkinName)
                                elseif gunOn then
                                    applyRainbowToTool(tool)
                                end
                            end
                        end
                    end
                end
            end
        end

        -- Force local equipped tool every frame (FP uses same Tool meshes)
        local char = Players.LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                if skinOn then
                    applySkinToTool(tool, selectedSkinName)
                elseif gunOn then
                    applyRainbowToTool(tool)
                end
            end
            local bw = char:FindFirstChild("Backweapon")
            if bw then
                if skinOn then
                    applySkinToTool(bw, selectedSkinName)
                elseif gunOn then
                    applyRainbowToTool(bw)
                end
            end
        end
        updateViewModel()
    end)
end

local function stopGunLoopIfIdle()
    local gunOn = Toggles.GunESP and Toggles.GunESP.Value
    local skinOn = skinChangerEnabled and selectedSkinName ~= nil
    if not gunOn and not skinOn then
        if gunConn then gunConn:Disconnect(); gunConn = nil end
        gunEspCache = {}
    end
end

local function startGunESP()
    startGunLoop()
end

local function stopGunESP()
    stopGunLoopIfIdle()
end



-- ---------- MASTER ESP LOOP (restored) ----------
local masterConn = nil
local radarConn = nil
local radarUI = nil
local ESP_FRAME_SKIP = 1
local _espFrame = 0
local _charmsFrame = 0

local function startMasterLoop()
    if masterConn then return end
    masterConn = RunService.RenderStepped:Connect(function()
        _espFrame = _espFrame + 1
        if ESP_FRAME_SKIP > 0 and (_espFrame % (ESP_FRAME_SKIP + 1)) ~= 0 then
            return
        end

        local cam = Workspace.CurrentCamera
        if not cam then return end

        local doHealth = Toggles.HealthBar and Toggles.HealthBar.Value
        local doSkel = Toggles.Skeletons and Toggles.Skeletons.Value
        local doBox = Toggles.BoxESP and Toggles.BoxESP.Value
        local doCorner = Toggles.CornerBox and Toggles.CornerBox.Value
        local doArrow = Toggles.ArrowTracers and Toggles.ArrowTracers.Value
        local doView = Toggles.ViewTracers and Toggles.ViewTracers.Value
        local doCharmsToggle = Toggles.Charms and Toggles.Charms.Value

        _charmsFrame = _charmsFrame + 1
        local doCharms = doCharmsToggle and ((_charmsFrame % 2) == 0)

        if not (doHealth or doSkel or doBox or doCorner or doArrow or doView or doCharmsToggle) then
            return
        end

        local players = Players:GetPlayers()
        local localChar = Players.LocalPlayer.Character
        local viewport = cam.ViewportSize
        local center = viewport / 2

        for i = 1, #players do
            local plr = players[i]
            if plr ~= Players.LocalPlayer then
                if not shouldShowPlayer(plr) then
                    hideAllForPlayer(plr)
                else
                    local char, hum, hrp = getValidCharacter(plr)
                    if not char then
                        hideAllForPlayer(plr)
                    else
                        local rootPos = hrp.Position
                        local screenPos, onScreen = cam:WorldToViewportPoint(rootPos)

                        if doHealth then
                            local h = ensureHealth(plr)
                            if onScreen and screenPos.Z > 0 then
                                local hp = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                                local barHeight, barWidth = 50, 4
                                local x = (healthBarSide == "Right") and (screenPos.X + 30) or (screenPos.X - 30 - barWidth)
                                local y = screenPos.Y - barHeight / 2
                                h.bg.Size = Vector2.new(barWidth, barHeight)
                                h.bg.Position = Vector2.new(x, y)
                                h.bg.Visible = true
                                local fh = barHeight * hp
                                h.bar.Size = Vector2.new(barWidth, fh)
                                h.bar.Position = Vector2.new(x, y + (barHeight - fh))
                                h.bar.Color = getHealthColor(hp)
                                h.bar.Visible = true
                                h.outline.Size = Vector2.new(barWidth, barHeight)
                                h.outline.Position = Vector2.new(x, y)
                                h.outline.Visible = true
                            else
                                h.bg.Visible = false; h.bar.Visible = false; h.outline.Visible = false
                            end
                        elseif espState.health[plr] then
                            local h = espState.health[plr]
                            h.bg.Visible = false; h.bar.Visible = false; h.outline.Visible = false
                        end

                        if doBox then
                            local b = ensureBox(plr)
                            b.box.Color = Colors.Box
                            if onScreen and screenPos.Z > 0 then
                                local top = cam:WorldToViewportPoint(rootPos + Vector3.new(0, 3, 0))
                                local bottom = cam:WorldToViewportPoint(rootPos + Vector3.new(0, -3.5, 0))
                                local sizeY = math.abs(top.Y - bottom.Y)
                                local sizeX = sizeY * 0.6
                                b.box.Size = Vector2.new(sizeX, sizeY)
                                b.box.Position = Vector2.new(screenPos.X - sizeX / 2, screenPos.Y - sizeY / 2)
                                b.box.Visible = true
                            else
                                b.box.Visible = false
                            end
                        elseif espState.box[plr] then
                            espState.box[plr].box.Visible = false
                        end

                        if doSkel then
                            local s = ensureSkeleton(plr)
                            local joints = getJoints(char)
                            if joints then
                                for j = 1, #joints do
                                    local joint = joints[j]
                                    local p0 = char:FindFirstChild(joint[1])
                                    local p1 = char:FindFirstChild(joint[2])
                                    local line = s.lines[j]
                                    if p0 and p1 and line then
                                        local a, oa = cam:WorldToViewportPoint(p0.Position)
                                        local b2, ob = cam:WorldToViewportPoint(p1.Position)
                                        if oa and ob and a.Z > 0 and b2.Z > 0 then
                                            line.From = Vector2.new(a.X, a.Y)
                                            line.To = Vector2.new(b2.X, b2.Y)
                                            line.Color = Colors.Skeleton
                                            line.Visible = true
                                        else
                                            line.Visible = false
                                        end
                                    elseif line then
                                        line.Visible = false
                                    end
                                end
                                for j = #joints + 1, 14 do
                                    s.lines[j].Visible = false
                                end
                            else
                                for j = 1, 14 do s.lines[j].Visible = false end
                            end
                        elseif espState.skeleton[plr] then
                            for _, l in ipairs(espState.skeleton[plr].lines) do l.Visible = false end
                        end

                        if doCorner then
                            local c = ensureCorner(plr)
                            local lines = c.lines
                            for k = 1, 8 do lines[k].Color = Colors.Corner end
                            if onScreen and screenPos.Z > 0 then
                                local oripart = c.oripart
                                oripart.Size = Vector3.new(hrp.Size.X, hrp.Size.Y * 1.5, hrp.Size.Z)
                                oripart.CFrame = CFrame.new(hrp.CFrame.Position, cam.CFrame.Position)
                                local SX, SY = oripart.Size.X, oripart.Size.Y
                                local TL = cam:WorldToViewportPoint((oripart.CFrame * CFrame.new(SX, SY, 0)).p)
                                local TR = cam:WorldToViewportPoint((oripart.CFrame * CFrame.new(-SX, SY, 0)).p)
                                local BL = cam:WorldToViewportPoint((oripart.CFrame * CFrame.new(SX, -SY, 0)).p)
                                local BR = cam:WorldToViewportPoint((oripart.CFrame * CFrame.new(-SX, -SY, 0)).p)
                                local offset = math.clamp(750 / math.max((cam.CFrame.p - rootPos).Magnitude, 1), 2, 300)
                                lines[1].From = Vector2.new(TL.X, TL.Y); lines[1].To = Vector2.new(TL.X + offset, TL.Y)
                                lines[2].From = Vector2.new(TL.X, TL.Y); lines[2].To = Vector2.new(TL.X, TL.Y + offset)
                                lines[3].From = Vector2.new(TR.X, TR.Y); lines[3].To = Vector2.new(TR.X - offset, TR.Y)
                                lines[4].From = Vector2.new(TR.X, TR.Y); lines[4].To = Vector2.new(TR.X, TR.Y + offset)
                                lines[5].From = Vector2.new(BL.X, BL.Y); lines[5].To = Vector2.new(BL.X + offset, BL.Y)
                                lines[6].From = Vector2.new(BL.X, BL.Y); lines[6].To = Vector2.new(BL.X, BL.Y - offset)
                                lines[7].From = Vector2.new(BR.X, BR.Y); lines[7].To = Vector2.new(BR.X - offset, BR.Y)
                                lines[8].From = Vector2.new(BR.X, BR.Y); lines[8].To = Vector2.new(BR.X, BR.Y - offset)
                                for k = 1, 8 do lines[k].Visible = true end
                            else
                                for k = 1, 8 do lines[k].Visible = false end
                            end
                        elseif espState.corner[plr] then
                            for _, l in ipairs(espState.corner[plr].lines) do l.Visible = false end
                        end

                        if doArrow then
                            local a = ensureArrow(plr)
                            a.tri.Color = Colors.Arrow
                            if not onScreen then
                                local lp = localChar and localChar.PrimaryPart
                                if lp then
                                    local rootP = hrp.Position
                                    local camP = cam.CFrame.Position
                                    local relative = CFrame.new(Vector3.new(rootP.X, camP.Y, rootP.Z), camP):PointToObjectSpace(rootP)
                                    local rel = Vector2.new(relative.X, relative.Z)
                                    if rel.Magnitude > 0.001 then
                                        local dir = rel.Unit
                                        local DistFromCenter, TriangleHeight, TriangleWidth = 80, 16, 16
                                        local function rot(v, deg)
                                            local r = math.rad(deg)
                                            return Vector2.new(v.X * math.cos(r) - v.Y * math.sin(r), v.X * math.sin(r) + v.Y * math.cos(r))
                                        end
                                        local base = dir * DistFromCenter
                                        local side = TriangleWidth / 2
                                        local baseL = base + rot(dir, 90) * side
                                        local baseR = base + rot(dir, -90) * side
                                        local tip = dir * (DistFromCenter + TriangleHeight)
                                        a.tri.PointA = center - baseL
                                        a.tri.PointB = center - baseR
                                        a.tri.PointC = center - tip
                                        a.tri.Visible = true
                                    else
                                        a.tri.Visible = false
                                    end
                                else
                                    a.tri.Visible = false
                                end
                            else
                                a.tri.Visible = false
                            end
                        elseif espState.arrow[plr] then
                            espState.arrow[plr].tri.Visible = false
                        end

                        if doView then
                            local v = ensureView(plr)
                            v.line.Color = Colors.View
                            local head = char:FindFirstChild("Head")
                            if head then
                                local headpos, headOn = cam:WorldToViewportPoint(head.Position)
                                if headOn and headpos.Z > 0 then
                                    local offsetCF = CFrame.new(0, 0, -15)
                                    local found = false
                                    v.line.From = Vector2.new(headpos.X, headpos.Y)
                                    for _ = 1, 40 do
                                        local dir = head.CFrame:ToWorldSpace(offsetCF)
                                        offsetCF = offsetCF * CFrame.new(0, 0, 0.2)
                                        local dirpos, vis = cam:WorldToViewportPoint(dir.Position)
                                        if vis then
                                            v.line.To = Vector2.new(dirpos.X, dirpos.Y)
                                            v.line.Visible = true
                                            found = true
                                            break
                                        end
                                    end
                                    if not found then v.line.Visible = false end
                                else
                                    v.line.Visible = false
                                end
                            else
                                v.line.Visible = false
                            end
                        elseif espState.view[plr] then
                            espState.view[plr].line.Visible = false
                        end

                        if doCharms then
                            local col = (plr.TeamColor == Players.LocalPlayer.TeamColor) and Colors.CharmsTeam or Colors.CharmsEnemy
                            for _, part in ipairs(char:GetChildren()) do
                                if part:IsA("BasePart") and CHARM_PART_NAMES[part.Name] then
                                    local qs = ensureCharmPart(plr, part.Name)
                                    local _, partOn = cam:WorldToViewportPoint(part.Position)
                                    if partOn then
                                        local sx, sy, sz = part.Size.X / 2, part.Size.Y / 2, part.Size.Z / 2
                                        local cf = part.CFrame
                                        local function wp(ox, oy, oz)
                                            local p = cam:WorldToViewportPoint((cf * CFrame.new(ox, oy, oz)).p)
                                            return Vector2.new(p.X, p.Y)
                                        end
                                        local T1, T2, T3, T4 = wp(-sx, sy, -sz), wp(-sx, sy, sz), wp(sx, sy, sz), wp(sx, sy, -sz)
                                        local B1, B2, B3, B4 = wp(-sx, -sy, -sz), wp(-sx, -sy, sz), wp(sx, -sy, sz), wp(sx, -sy, -sz)
                                        qs[1].PointA, qs[1].PointB, qs[1].PointC, qs[1].PointD = T1, T2, T3, T4
                                        qs[2].PointA, qs[2].PointB, qs[2].PointC, qs[2].PointD = B1, B2, B3, B4
                                        qs[3].PointA, qs[3].PointB, qs[3].PointC, qs[3].PointD = T1, T2, B2, B1
                                        qs[4].PointA, qs[4].PointB, qs[4].PointC, qs[4].PointD = T2, T3, B3, B2
                                        qs[5].PointA, qs[5].PointB, qs[5].PointC, qs[5].PointD = T3, T4, B4, B3
                                        qs[6].PointA, qs[6].PointB, qs[6].PointC, qs[6].PointD = T4, T1, B1, B4
                                        for qi = 1, 6 do
                                            qs[qi].Color = col
                                            qs[qi].Visible = true
                                        end
                                    else
                                        for qi = 1, 6 do qs[qi].Visible = false end
                                    end
                                end
                            end
                        elseif espState.charms[plr] then
                            for _, qs in pairs(espState.charms[plr].quads) do
                                for _, q in ipairs(qs) do q.Visible = false end
                            end
                        end
                    end
                end
            end
        end
    end)
end

