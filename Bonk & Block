local function ensureCharmPart(player, partName)
    local st = ensureCharms(player)
    if st.quads[partName] then return st.quads[partName] end
    local qs = {}
    for i = 1, 6 do
        local q = Drawing.new("Quad")
        q.Visible = false
        q.Filled = true
        q.Thickness = 1
        q.Transparency = 0.25
        q.Color = Colors.CharmsEnemy
        qs[i] = q
    end
    st.quads[partName] = qs
    return qs
